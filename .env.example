# Server only. Never put these values in index.html or static/app.js.
GEMINI_API_KEY=
GEMINI_ANALYSIS_MODEL=gemini-2.5-flash
GEMINI_API_TIMEOUT=60

# Photo analysis only: switch to local Ollama on Gemini HTTP 429.
# Install Ollama and run: ollama pull qwen2.5vl:3b
ENABLE_OLLAMA_FALLBACK=true
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_ANALYSIS_MODEL=qwen2.5vl:3b
OLLAMA_API_TIMEOUT=120

# Optional experimental macro-scalp reference trained locally for both providers.
SCALP_MODEL_DIR=models/scalp-classifier

HAIR_MODEL_PATH=models/hair_segmenter.tflite
PORT=8000

# Optional local WebSocket transport; the existing HTTP server stays on PORT.
ENABLE_WEBSOCKET=true
WEBSOCKET_PORT=8001

# Optional: local CUDA GPU + locally downloaded Diffusers inpainting model.
ENABLE_SD_INPAINTING=false
SD_MODEL_PATH=

# Optional paid API. Requires an explicit checkbox in the UI as well.
ENABLE_PAID_IMAGE_GENERATION=false
GEMINI_IMAGE_MODEL=

# Optional session signing key. If empty, a private local key file is generated.
APP_SECRET_KEY=
# Local SQLite: accounts, sessions, reports and account-owned photo BLOBs.
DATABASE_PATH=data/hairline.sqlite3
